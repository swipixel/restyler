{
  "schemaVersion": 1,
  "id": "restyler",
  "version": "${version}",
  "name": "Restyler",
  "description": "Local real-time AI restyling for Minecraft on your own GPU. Realistic materials, and WetCraft when it rains.",
  "authors": [
    "SwiPixel"
  ],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.swipixel.restyler.RestylerClient"
    ]
  },
  "mixins": [
    "restyler.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
